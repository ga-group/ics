	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Catéter de sonda"@es , "Cateteres guias"@pt , "Cathéters de guidage"@fr , "Führungskatheder"@de , "Guide cateteri"@it , "Guiding Catheters"@en , "Проводниковые катетеры"@ru , "導引導管"@zh-hant , "指引导管"@zh , "유도 카테터"@ko , "ｶﾞｲﾃﾞｨﾝｸﾞｶﾃｰﾃﾙ"@ja ;
	skos:definition	"This segment includes companies that manufacture guiding catheters. Such catheters help deliver interventional devices to the coronary and peripheral vascular systems. An example is the Vista Brite Tip manufactured by Johnson & Johnson (JNJ US)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151212101117>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/2014/1512121011> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/151212101117> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/151212101117> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Bainhas introdutoras"@pt , "Einführungshülse"@de , "Gaines d'insertion"@fr , "Guaine introduttive"@it , "Introducer Sheaths"@en , "Vendajes internos"@es , "Стилеты-катетеры"@ru , "中空型护套"@zh , "導管引導鞘"@zh-hant , "抹消血管装置"@ja , "삽입관"@ko ;
	skos:definition	"This segment includes companies that manufacture introducer sheaths. Such devices allow access to arteries and allow insertion of other instruments to perform coronary angioplasty in the arteries. An example of such a device is the Pinnacle TIF Tip introducer manufactured by Terumo (4543 JP)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151212101118>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/2014/1512121011> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/151212101118> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/151212101118> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Catéteres IVUS"@es , "Cateteres JVUS"@pt , "Cateteri IVUS"@it , "Cathéters IVUS"@fr , "IVUS Catheters"@en , "IVUS 导管"@zh , "IVUS 카테터"@ko , "IVUS-Katheder"@de , "IVUSｶﾃｰﾃﾙ"@ja , "Внутрисосудистые ультразвуковые катетеры"@ru , "血管內超音波導管"@zh-hant ;
	skos:definition	"This segment includes companies that manufacture intravascular ultrasound (IVUS) catheters. Such devices use ultrasound imaging to evaluate blocked arteries before and after stent placement. An example of such a device is the Eagle Eye Platinum catheter manufactured by Volcano Corporation (VOLC US)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151212101119>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/2014/1512121011> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/151212101119> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/151212101119> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Angioplastica"@it , "Balões PTCA"@pt , "Ballonnets PTCA"@fr , "PTCA Balloons"@en , "PTCA Globos"@es , "PTCA 球囊"@zh , "PTCA 벌룬"@ko , "PTCA-Ballons"@de , "PTCAﾊﾞﾙｰﾝ"@ja , "Шары ЧТКА"@ru , "冠狀動脈氣球導管"@zh-hant ;
	skos:definition	"This segment includes companies that manufacture percutaneous transluminal coronary angioplasty (PTCA) balloons. These devices are used in angioplasty procedures (also called percutaneous coronary interventions, or PCIs) and are rapidly inflated and deflated to unblock arteries by pushing plaque up against the artery walls. An example is the Maverick balloon manufactured by Boston Scientific (BSX US)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/1512121011>
	a	bddc:BicsLevel5Segment ;
	a	bics:Classifier , owl:NamedIndividual ;
	bics:isLevel5SegmentOf	<http://data.ga-group.nl/ics/bics/2014/15121210> ;
	dct:isAnachronousVersionOf	<http://data.ga-group.nl/ics/bics/161012121011> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/1512121011> ;
	dct:isReplacedBy	<http://data.ga-group.nl/ics/bics/2020/161012121011> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/1512121011> , <http://data.ga-group.nl/ics/bics/161012121011> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Cardiologia interventiva"@it , "Cardiologia interventiva"@pt , "Cardiologie interventionnelle"@fr , "Cardología de intervención"@es , "Interventional Cardiology"@en , "Interventionelle Kardiologie"@de , "Хирургическая кардиология"@ru , "介入心脏病学"@zh , "介入性心臓装置"@ja , "介入性心臟學"@zh-hant , "심혈관 중재시술"@ko ;
	skos:definition	"This segment includes devices that do not generate an electrical pulse but are used in interventional cardiology procedures to repair heart damage and in peripheral vascular procedures to treat vascular diseases (especially blood vessels). Also included are devices used to treat endovascular diseases (such as abdominal aortic aneurysms) but not endoscopy. Products include coronary stents (drug-eluting and bare-metal), heart valves, coronary stent grafts, cardiac surgery devices, vascular closure devices, vascular plugs, IVUS catheters, atherectomy devices, and peripheral vascular and neurovascular stents and coils."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/15121210>
	a	bddc:BicsLevel4SubIndustry ;
	a	bics:Classifier , owl:NamedIndividual ;
	bics:isSubIndustryOf	<http://data.ga-group.nl/ics/bics/2014/151212> ;
	dct:isAnachronousVersionOf	<http://data.ga-group.nl/ics/bics/1610121210> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/15121210> ;
	dct:isReplacedBy	<http://data.ga-group.nl/ics/bics/2020/1610121210> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/15121210> , <http://data.ga-group.nl/ics/bics/1610121210> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Aparelhos cardiov"@pt , "Appareils cardiovasculaires"@fr , "Cardiovascular Devices"@en , "Disp cardiov"@es , "Dispositivi cardiovascolari"@it , "Kardiovaskuläre Geräte"@de , "Кардиоваскулярное оборудование"@ru , "心臓血管装置"@ja , "心血管器材"@zh-hant , "心血管设备"@zh , "심혈관 장치"@ko ;
	skos:definition	"This industry subgroup includes companies that manufacture electromedical and interventional cardiovascular devices that use electrical impulses to stimulate action. Such devices include pacemakers, implantable cardioverter-defibrillators (ICDs), ventricle assist devices (VADs), defibrillators, drug-eluting stents, bare-metal stents, heart valves, coronary stent grafts, cardiac surgery products, and any other cardiovascular device that is not disposable and is not a heart monitor."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/15121211>
	a	bddc:BicsLevel4SubIndustry ;
	a	bics:Classifier , owl:NamedIndividual ;
	bics:isSubIndustryOf	<http://data.ga-group.nl/ics/bics/2014/151212> ;
	dct:isAnachronousVersionOf	<http://data.ga-group.nl/ics/bics/1610121211> ;
