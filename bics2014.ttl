	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Aparelhos para eletrofisiologia"@pt , "Appareils d'électrophysiologie"@fr , "Dispositivi elettrofisiologici"@it , "Dispositivos de electrofisiología"@es , "Electrophysiology Devices"@en , "Elektrophysiologische Geräte"@de , "Электрофизиологич. устройства"@ru , "电生理设备"@zh , "電気生理検査装置"@ja , "電生理學器材"@zh-hant , "전기생리학 기기"@ko ;
	skos:definition	"This segment includes companies that manufacture electrophysiology devices. These devices typically treat an arrhythmia of the heart (irregular beat) by generating electrical impulses to regulate the heartbeat and are often implanted in or near the patient's heart. This segment also includes companies that manufacture heart pumps and blood pumps that assist a failing heart, as well as replacement hearts. It also includes catheters to treat atrial fibrillation. Products include: pacemakers, implantable cardioverter-defibrillators (ICDs), ventricle assist devices (VADs), defibrillators, ablation catheters, and any other cardiovascular device that uses an electrical impulse that is not a heart monitor."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151212101110>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/2014/1512121011> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/151212101110> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/151212101110> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Bare Metal Stents"@en , "Endopróteses metálicas"@pt , "Reine Metallstents"@de , "Stents metálicos descubiertos"@es , "Stents nus en métal"@fr , "Supporti venosi"@it , "Оголенные металлические стенты"@ru , "地金ｽﾃﾝﾄ"@ja , "金属裸支架"@zh , "金屬血管支架"@zh-hant , "금속 스텐트"@ko ;
	skos:definition	"This segment includes companies that manufacture bare-metal stents. Such tiny metal devices are placed in previously blocked arteries to prevent them from becoming blocked again. An example is Medtronic's Integrity bare-metal stent."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151212101111>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/2014/1512121011> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/151212101111> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/151212101111> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Cáteres de diagnóstico"@es , "Cateteres de diagnósticos"@pt , "Cateteri"@it , "Cathéters de diagnostic"@fr , "Diagnostic Catheters"@en , "Diagnostische Katheder"@de , "Диагностические катетеры"@ru , "診断ｶﾃｰﾃﾙ"@ja , "診斷導管"@zh-hant , "诊断导管"@zh , "진단 카테터"@ko ;
	skos:definition	"This segment includes companies that manufacture diagnostic catheters. Such devices are used in coronary and peripheral vascular procedures, often to deliver contrast medium to selected sites in the vascular system. An example is the Infiniti catheter manufactured by Johnson & Johnson."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151212101112>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/2014/1512121011> ;
