	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Führungsdraht"@de , "Fils de guidage"@fr , "Fios guias"@pt , "Guide"@it , "Guide-Wires"@en , "Sondas"@es , "Проволочные направители"@ru , "导丝"@zh , "導引線"@zh-hant , "유도 철사"@ko , "ｶﾞｲﾄﾞﾜｲﾔ"@ja ;
	skos:definition	"This segment includes companies that manufacture guide wires. These devices are used to facilitate placement of balloon catheters during angioplasty procedures. An example of such a device is the Asahi Prowater guide wire manufactured by Abbott Labs (ABT US)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151212101116>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/2014/1512121011> ;
