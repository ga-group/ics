	rdfs:label	"Aparelhos para coluna vertebral"@pt , "Appareils pour la colonne vertébrale"@fr , "Dispositivi vertrebrali"@it , "Dispositivos de columna"@es , "Spinal Devices"@en , "Spinalgeräte"@de , "Устройства для лечения заболеваний позвоночника"@ru , "脊椎器材"@zh-hant , "脊椎设备"@zh , "脊髄装置"@ja , "척추 장치"@ko ;
	skos:definition	"This segment includes companies that manufacture devices and their related biologics to treat spine-related disorders, such as back pain, degenerative disc disease, arthritis, spinal stenosis, and lumbar disc herniation. Products include Medtronic's Infuse bone graft and Prestige cervical disc; Synthes' ProDisc-L lumbar disc; Biomet's MaxAn cervical plate system, and Exactech's Procyon pedicle screw system."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

