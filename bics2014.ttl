	skos:definition	"This segment includes companies that manufacture all reconstructive implants and all other orthopedic devices unrelated to spinal disorders. This category includes major joints (hips, knees and shoulders), bone cement and dental devices."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

