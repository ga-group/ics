	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Diagnóstico in vitro"@es , "Diagnóstico in vitro"@pt , "Diagnostica in vitro"@it , "Diagnostiques in vitro"@fr , "In Vitro Diagnostics"@en , "In-vitro-Diagnostik"@de , "Диагностика в лабораторных условиях"@ru , "体外診断"@ja , "体外诊断"@zh , "體外診斷"@zh-hant , "체외 진료"@ko ;
	skos:definition	"This industry subgroup includes companies that manufacture in-vitro (not internal) diagnostic substances. These substances are used for diagnostic tests that are performed in test tubes, petri dishes, and machines."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151211>
	a	bddc:BicsLevel3Industry ;
	a	bics:Classifier , owl:NamedIndividual ;
	bics:isIndustryOf	<http://data.ga-group.nl/ics/bics/2014/1512> ;
	dct:isAnachronousVersionOf	<http://data.ga-group.nl/ics/bics/16101211> ;
