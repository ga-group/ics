	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/151012> , <http://data.ga-group.nl/ics/bics/1610101210> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Fármacos especiales"@es , "Farma specializzata"@it , "Farmac especializ"@pt , "Prod pharma spécialisés"@fr , "Specialty Pharma"@en , "Spezielle Pharma."@de , "Специальная фармацевтика"@ru , "特殊医薬品"@ja , "特殊药品"@zh , "特殊製藥"@zh-hant , "전문 제약업체"@ko ;
	skos:definition	"This industry includes companies that specialize in developing, manufacturing and marketing pharmaceuticals. Typically, these companies are less R&D focused and more marketing driven. They may seek M&A activities to expand their drug portfolios or vertically integrate. Furthermore, these companies engage in less risky drug developments, such as reformulations and branded generics. Some common products include botanical-based medicine, nutraceuticals, over-the-counter (OTC) drugs and veterinary medicine."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

