	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Aparatos y provisiones de cirugía"@es , "Aparelhos e materiais cirúrgicos"@pt , "Chirurgische Geräte & Bedarf"@de , "Forniture e apparecchi chirurgici"@it , "Fournitures et appareils chirurgicaux"@fr , "Surgical Appliances & Supplies"@en , "Хирургическая аппаратура и расходные материалы"@ru , "外科器械与用品"@zh , "外科用器具及用品"@zh-hant , "外科用機器･外科用品"@ja , "수술장비 & 수술용품"@ko ;
	skos:definition	"This industry subgroup includes companies that manufacture medical supplies. These are the supplies and products used or consumed in surgery, such as bandages, dressings, tape, sutures and syringes. Medical supplies typically are disposable, while devices and equipment usually are implanted or reusable (in the case of an instrument)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

