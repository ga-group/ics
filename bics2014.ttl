	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/151212101112> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Cierre vascular de diagnóstico"@es , "Diagnostic Vascular Closures"@en , "Diagnostic d'obstruction vasculaire"@fr , "Diagnostica chiusure vascolari"@it , "Diagnostische Gefäßverschlüsse"@de , "Fechamento vasculares de diagnóstico"@pt , "Диагностические сосудистые клипсы"@ru , "血管閉鎖装置"@ja , "診斷血管閉合"@zh-hant , "诊断血管封合器"@zh , "진단 혈관 폐쇄 기구"@ko ;
	skos:definition	"This segment includes companies that manufacture vascular closure devices. Such devices are used to close an artery after a surgery has been performed requiring the use of a catheter inserted into the artery under the skin. An example is the angioseal device manufactured by St. Jude Medical (STJ US)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151212101113>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/2014/1512121011> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/151212101113> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/151212101113> ;
