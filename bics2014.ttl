	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Ereignisgesteuerte Investitionen"@de , "Event-driven Investments"@en , "Inversiones por evento"@es , "Investim orientati agli eventi"@it , "Investimentos acionados por eventos"@pt , "Investissements menés par évènements"@fr , "Инвестиции на основе событий"@ru , "事件導向投資"@zh-hant , "事件驱动型投资"@zh , "이벤트 추구형 투자"@ko , "ｲﾍﾞﾝﾄ駆動投資"@ja ;
	skos:definition	"This segment includes companies that provide hedge fund investments that employ an event-driven investment strategy. Such a strategy is any trading or investment strategy that exploits pricing inefficiencies caused by anticipated specific corporate events. Types of event-driven hedge funds are distressed debt, merger arbitrage, credit arbitrage and activist funds that take large positions in companies to be active in management."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

