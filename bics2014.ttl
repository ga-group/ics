	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Estúdios de gravação de músicas"@pt , "Estudios de grabación del sonido"@es , "Sound Recording Studios"@en , "Studi di registrazione"@it , "Studios d'enregistrement sonore"@fr , "Tonaufnahmenstudios"@de , "Студии звукозаписи"@ru , "录音棚"@zh , "錄音室"@zh-hant , "録音ｽﾀｼﾞｵ業"@ja , "녹음시설 운영업"@ko ;
	skos:definition	"This segment includes companies that provide the facilities and technical expertise for sound recording in a studio. These companies provide audio production and postproduction services to produce master recordings. They may provide audio services for film, television and video productions."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/10101212>
