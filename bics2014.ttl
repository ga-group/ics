	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Global Macro Investments"@en , "Globale Makroinvestitionen"@de , "Inversiones macro globales"@es , "Investimenti macro globali"@it , "Investimentos macro globais"@pt , "Macro investissements mondiaux"@fr , "Инвестиции по глобальным макроэконом. факторам"@ru , "全球宏观投资"@zh , "全球總體投資"@zh-hant , "글로벌 매크로 투자"@ko , "ｸﾞﾛｰﾊﾞﾙﾏｸﾛ投資"@ja ;
	skos:definition	"This segment includes companies that provide hedge fund investments that employ a global macro investment strategy. Such a strategy is investing around the world using broad macroeconomic factors that forecast interest rate trends, business cycles, government policies, political changes and other broad systemic factors."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

