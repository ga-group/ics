	dct:isReplacedBy	<http://data.ga-group.nl/ics/bics/2020/1010121112> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/1010121112> , <http://data.ga-group.nl/ics/bics/1010121212> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Musikproduktion"@de , "Prod. enreg. sonore"@fr , "Produção de disco"@pt , "Producción de discos"@es , "Produzione di dischi"@it , "Record Production"@en , "Запись пластинок"@ru , "唱片製作"@zh-hant , "录制产品制作"@zh , "음반 제작업"@ko , "ﾚｺｰﾄﾞ制作業"@ja ;
	skos:definition	"This segment includes companies that produce records, such as tapes and compact discs. These companies contract with artists and arrange and finance the production of original master recordings. These companies also hold the copyright to the master recording and derive most of their revenues from the sales, leasing and licensing of master recordings. Such companies do not have their own duplication or distribution capabilities."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

