	rdfs:label	"Gerenc  invest"@pt , "Gestión inversión"@es , "Gestion d'investissements"@fr , "Gestione investimento"@it , "Investment Management"@en , "Investmentmanagement"@de , "Управление инвестиц."@ru , "投資管理"@ja , "投資管理"@zh-hant , "投资管理"@zh , "투자관리"@ko ;
	skos:definition	"This industry includes companies that provide traditional investment management services for individual and institutional investors. Major asset classes include equities, fixed income, mixed asset and hedge funds."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

