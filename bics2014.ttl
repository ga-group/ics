	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Attrezzature scienze vita"@it , "Biowissenschaftlische Ausrüstung"@de , "Equip ciência vida"@pt , "Equipements pour sciences de la vie"@fr , "Equipo de biología"@es , "Life Science Equipment"@en , "Биологич. оборудование"@ru , "生命科学仪器"@zh , "生命科学設備"@ja , "生命科學設備"@zh-hant , "생명 과학 설비"@ko ;
	skos:definition	"This industry includes companies that manufacture in-vitro (not internal) diagnostic substances. These substances are used for diagnostic tests that are performed in test tubes, petri dishes, and machines. This segment may also include companies that manufacture analytical laboratory instruments."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/15121210101010>
	a	bddc:BicsLevel7Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel7SegmentOf	<http://data.ga-group.nl/ics/bics/2014/151212101010> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/15121210101010> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/15121210101010> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Apparati CRT-D"@it , "Appareils CRT-D"@fr , "CRT-D Devices"@en , "CRT-D Dispositivos"@es , "CRT-D 设备"@zh , "CRT-D 기기"@ko , "CRT-D-Geräte"@de , "CRT-D機器"@ja , "Dispositivos CTR-D"@pt , "Устройства CRT-D"@ru , "心臟再同步治療法除顫器"@zh-hant ;
	skos:definition	"This segment includes companies that manufacture cardiac resynchronization therapy with defibrillator devices (CRT-Ds). Such devices combine a standard implantable cardioverter-defibrillator (ICD) with a cardiac resynchronization therapy pacemaker (CRT-P) to treat CRT patients at high risk of sudden death from rapid heartbeats. The device is composed of two pieces: the can, which generates the electrical pulses, and the leads, which deliver the pulses to the heart. These devices are implanted under the skin near the heart with the leads placed in the chambers of the heart. An example of such a device is the Consulta CRT-D manufactured by Medtronic (MDT US)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/15121210101011>
	a	bddc:BicsLevel7Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel7SegmentOf	<http://data.ga-group.nl/ics/bics/2014/151212101010> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/15121210101011> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/15121210101011> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Apparati CRT-P"@it , "Appareils CRT-P"@fr , "CRT-P Devices"@en , "CRT-P Dispositivos"@es , "CRT-P 设备"@zh , "CRT-P 기기"@ko , "CRT-P-Geräte"@de , "CRT-P機器"@ja , "Dispositivos CTR-P"@pt , "Устройства CRT-P"@ru , "心臟再同步治療法心律節律器"@zh-hant ;
	skos:definition	"This segment includes companies that manufacture cardiac resynchronization therapy with pacemaker devices (CRT-Ps). These devices use three leads (while normal pacemakers use just two) to treat patients with excessively slow heartbeats and stimulate the heartbeat when necessary. The devices are composed of two pieces: the can, which generates the electrical pulses, and the leads, which deliver the pulses to the heart. These devices are implanted under the skin near the heart with the leads placed in the chambers of the heart. An example of such a device is the Anthem CRT-P manufactured by St. Jude Medical (STJ US)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/15121210101012>
	a	bddc:BicsLevel7Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel7SegmentOf	<http://data.ga-group.nl/ics/bics/2014/151212101010> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/15121210101012> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/15121210101012> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Implantable Cardiac Monitors"@en , "Implantierbare Herzüberwachungsgeräte"@de , "Moniteurs cardiaques implantables"@fr , "Monitor protesi cardiache"@it , "Monitores cardíacos implantáveis"@pt , "Monitores cardiacos de implante"@es , "Имплантируемые сердечные мониторы"@ru , "植入式心內監測系統"@zh-hant , "植込型除細動器ﾓﾆﾀｰ"@ja , "移植心脏监视器"@zh , "이식형 심장모니터"@ko ;
	skos:definition	"This segment includes companies that manufacture implantable cardiac monitors. Such devices are usually implanted under the skin in the upper chest and send data on the patient to their physicians if they experience symptoms such as irregular heartbeats (arrhythmias). An example device is the SJM Confirm manufactured by St. Jude Medical (STJ US)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/15121210101013>
	a	bddc:BicsLevel7Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel7SegmentOf	<http://data.ga-group.nl/ics/bics/2014/151212101010> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/15121210101013> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/15121210101013> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"ICD"@de , "ICD"@en , "ICD"@es , "ICD"@fr , "ICD"@it , "ICD"@ja , "ICD"@ko , "ICD"@pt , "ICD"@ru , "ICD"@zh , "植入性心臟整流去顫器"@zh-hant ;
	skos:definition	"This segment includes companies that manufacture implantable cardioverter-defibrillators (ICDs). Such devices deliver high-energy shocks to the heart to correct rapid and sustained irregular heartbeats (called arrhythmias). These devices are composed of two pieces: the can, which generates the electrical pulses, and the leads, which deliver the pulses to the heart. These devices are implanted under the skin near the heart with the leads placed in the chambers of the heart. An example of such a device is the Fortify ICD manufactured by St. Jude Medical (STJ US)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/15121210101014>
	a	bddc:BicsLevel7Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel7SegmentOf	<http://data.ga-group.nl/ics/bics/2014/151212101010> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/15121210101014> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/15121210101014> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Herzschrittmacher"@de , "Marcapasos"@es , "Marcapassos"@pt , "Pacemakers"@en , "Pacemakers"@it , "Stimulateurs cardiaques"@fr , "Кардиостимуляторы"@ru , "節律器"@zh-hant , "起搏器"@zh , "심박조율기"@ko , "ﾍﾟｰｽﾒｰｶｰ"@ja ;
	skos:definition	"This segment includes companies that manufacture pacemakers. These devices deliver electrical impulses to correct abnormally slow heart rhythms (arrhythmias). The device is composed of two pieces: the can, which generates the electrical pulses, and the leads which deliver the pulses to the heart. These devices are implanted under the skin near the heart with the leads placed in the chambers of the heart. Newer generations of pacemakers are considered MRI-safe. An example of such a device is the Revo pacemaker manufactured by Medtronic (MDT US)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151212101010>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/2014/1512121010> ;
	dct:isAnachronousVersionOf	<http://data.ga-group.nl/ics/bics/16101212101010> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/151212101010> ;
	dct:isReplacedBy	<http://data.ga-group.nl/ics/bics/2020/16101212101010> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/151212101010> , <http://data.ga-group.nl/ics/bics/16101212101010> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Cardiac Rhythm Management"@en , "Contrôle du rythme cardiaque"@fr , "Gerenciamento de ritmo cardíaco"@pt , "Gestión de ritmo cardiaco"@es , "Gestione cardiologia"@it , "Herzrhythmus-Management"@de , "Система мер по управл. част. сердечных сокращений"@ru , "心律動管理"@ja , "心律管理"@zh , "心律調節管理"@zh-hant , "심장박동관리"@ko ;
	skos:definition	"This segment includes companies that manufacture cardiac rhythm management products that treat irregular heartbeats by generating electrical impulses to regulate the heartbeat. Such products include implantable cardioverter-defibrillators (ICDs), pacemakers, cardiac resynchronization therapy devices (CRT-Ds and CRT-Ps) and implantable cardiac monitors."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151212101011>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/2014/1512121010> ;
	dct:isAnachronousVersionOf	<http://data.ga-group.nl/ics/bics/16101212101011> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/151212101011> ;
	dct:isReplacedBy	<http://data.ga-group.nl/ics/bics/2020/16101212101011> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/bics/151212101011> , <http://data.ga-group.nl/ics/bics/16101212101011> ;
	pav:importedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Apparati assist ventricolare"@it , "Appareils de support ventriculaire"@fr , "Dispositivos auxiliar ventricular"@pt , "Dispositivos de asistencia ventricular"@es , "Ventricular Assist Devices"@en , "Ventrikulare Hilfsvorrichtungen"@de , "Вспоспомогательные желудочковые системы"@ru , "心室補助装置"@ja , "心室輔助裝置"@zh-hant , "心室辅助装置"@zh , "심실보조장치"@ko ;
	skos:definition	"This segment includes companies that manufacture ventricular assist devices (VADs). These devices are mechanical pump-type devices that are surgically implanted to function as the left ventricle of a failing heart. These devices are used in heart transplant candidates as a bridge to transplant until a heart transplant is available or as destination therapy, meaning permanent implantation. Examples include Thoratec's HeartMate II and HeartWare's HVAD."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/1512121010>
	a	bddc:BicsLevel5Segment ;
