	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Drug Eluting Stents"@en , "Endopróteses revestidas com fármacos"@pt , "Endoprótesis liberadoras de fármacos"@es , "Medikamentenbeschichtete Stents"@de , "Stents à élution de médicaments"@fr , "Vene artificiali"@it , "Стенты с лекарственным покрытием"@ru , "塗藥血管支架"@zh-hant , "药物洗脱支架"@zh , "薬剤溶出ｽﾃﾝﾄ"@ja , "약물 용출성 스텐트"@ko ;
	skos:definition	"This segment includes companies that manufacture drug-eluting stents. These devices are tiny steel or cobalt chromium devices, often covered with a polymer, that release a drug over time. They are placed in a previously blocked artery to prevent the artery from becoming blocked again. An example of such a device is the PROMUS Element stent manufactured by Boston Scientific. (BSX US)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151212101114>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/2014/1512121011> ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/bics/151212101114> ;
