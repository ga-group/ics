	pav:lastRefreshedOn	"2026-06-08T13:03:47.798Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/bics/2014/> ;
	rdfs:label	"Appar protezione embolica"@it , "Appareils de protection contre les embolies"@fr , "Dispositivos de proteção embólico"@pt , "Dispositivos de protección embólica"@es , "Embolic Protection Devices"@en , "Embolieschutzvorrichtungen"@de , "Устройства противоэмболической защиты"@ru , "塞栓保護装置"@ja , "栓塞保护器"@zh , "栓子保護裝置"@zh-hant , "색전방지기구"@ko ;
	skos:definition	"This segment includes companies that manufacture embolic protection devices. Such devices are placed in the vessels to filter out floating debris in the blood that could cause a stroke. An example of such a device is the ev3 SpiderFX device manufactured by Covidien PLC (COV US)."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/2014/151212101115>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , bics:Discontinued , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/2014/1512121011> ;
