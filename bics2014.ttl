	rdfs:label	"Co-Investimentos"@pt , "Co-Investitionen"@de , "Co-Investments"@en , "Co-investimenti"@it , "Co-investissements"@fr , "Coinversiones"@es , "Со-инвестиции"@ru , "共同投資"@ja , "合作投資"@zh-hant , "联合投资"@zh , "공동투자"@ko ;
	skos:definition	"This industry subgroup includes companies that invest in a co-investment asset class of private equity financial sponsors. An equity co-investment is a minority investment in an operating company alongside a financial sponsor or other private equity investor in a leveraged buyout, recapitalization or growth capital transaction."@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

