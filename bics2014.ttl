<http://data.ga-group.nl/ics/bics/2014/151012>
	a	bddc:BicsLevel3Industry ;
	a	bics:Classifier , owl:NamedIndividual ;
	bics:isIndustryOf	<http://data.ga-group.nl/ics/bics/2014/1510> ;
	dct:isAnachronousVersionOf	<http://data.ga-group.nl/ics/bics/1610101210> ;
