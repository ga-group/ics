	sm:filename	"trbc2020.ttl" ;
	tempo:validFrom	"2020"^^xsd:gYear ;
	vann:preferredNamespacePrefix	"trbc2020"^^xsd:string ;
	vann:preferredNamespaceUri	"http://data.ga-group.nl/ics/trbc/2020/" .




