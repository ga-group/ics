		pav:sourceLastAccessedOn	"2024-06-05T14:42:36Z"^^xsd:dateTime ;
		rdfs:label	"Ventricular Assist Devices"@en ;
		skos:definition	"This segment includes companies that manufacture ventricular assist devices (VADs)."@en ;
		skos:notation	"16101212101011" ;
		tempo:validFrom	"2020-10-03"^^xsd:date ;
	] ;
	pav:sourceAccessedOn	"2023-07-03T18:11:29Z"^^xsd:dateTime ;
