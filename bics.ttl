	rdfs:isDefinedBy	bics: ;
	skos:definition	"This industry subgroup includes companies that provide building repair and maintenance services. Typically, these services are offered in an outsourcing model for property owners. These services include minor building repairs, painting, light fixture replacements and general handyman services. These companies may also hire and manage subcontractors, such as plumbers, electricians and HVAC specialists for more specialized services."@en ;
	skos:notation	"11141010" ;
	skos:prefLabel	"Facility Repair & Maintenance"@en ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

