		rdfs:label	"PTCA Balloons"@en ;
		skos:definition	"This segment includes companies that manufacture percutaneous transluminal coronary angioplasty (PTCA) balloons. These devices are used in angioplasty procedures (also called percutaneous coronary interventions, or PCIs) and are rapidly inflated and deflated to unblock arteries by pushing plaque up against the artery walls. An example is the Maverick balloon manufactured by Boston Scientific (BSX US)."@en ;
		skos:notation	"151212101119" ;
		tempo:validFrom	"2014-08-08"^^xsd:date ;
		tempo:validTill	"2020-10-03"^^xsd:date ;
