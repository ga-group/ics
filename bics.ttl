		pav:sourceLastAccessedOn	"2024-06-05T14:42:36Z"^^xsd:dateTime ;
		rdfs:label	"Interventional Cardiology"@en ;
		skos:definition	"This segment includes devices used in interventional cardiology procedures to repair heart damage and in peripheral vascular procedures to treat vascular and endovascular diseases. Includes coronary stents (drug-eluting and bare-metal), heart valves, coronary stent grafts, cardiac surgery devices, vascular closure devices, vascular plugs, IVUS catheters, atherectomy devices, and peripheral vascular and neurovascular stents and coils."@en ;
		skos:notation	"161012121011" ;
		tempo:validFrom	"2020-10-03"^^xsd:date ;
	] ;
	pav:sourceAccessedOn	"2023-07-03T18:11:29Z"^^xsd:dateTime ;
