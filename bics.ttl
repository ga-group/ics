		a	bddc:BicsLevel5Segment ;
		a	bics:Classifier , prov:ContemporaryDerivation ;
		pav:derivedFrom	<http://data.ga-group.nl/ics/bics/2014/1512121011> ;
		pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
		pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
		rdfs:label	"Interventional Cardiology"@en ;
		skos:definition	"This segment includes devices that do not generate an electrical pulse but are used in interventional cardiology procedures to repair heart damage and in peripheral vascular procedures to treat vascular diseases (especially blood vessels). Also included are devices used to treat endovascular diseases (such as abdominal aortic aneurysms) but not endoscopy. Products include coronary stents (drug-eluting and bare-metal), heart valves, coronary stent grafts, cardiac surgery devices, vascular closure devices, vascular plugs, IVUS catheters, atherectomy devices, and peripheral vascular and neurovascular stents and coils."@en ;
		skos:notation	"1512121011" ;
		tempo:validFrom	"2014-08-08"^^xsd:date ;
		tempo:validTill	"2020-10-03"^^xsd:date ;
	] ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	bics: ;
	rdfs:label	"Interventional Cardiology"@en ;
	skos:definition	"This segment includes devices that do not generate an electrical pulse but are used in interventional cardiology procedures to repair heart damage and in peripheral vascular procedures to treat vascular diseases (especially blood vessels). Also included are devices used to treat endovascular diseases (such as abdominal aortic aneurysms) but not endoscopy. Products include coronary stents (drug-eluting and bare-metal), heart valves, coronary stent grafts, cardiac surgery devices, vascular closure devices, vascular plugs, IVUS catheters, atherectomy devices, and peripheral vascular and neurovascular stents and coils."@en ;
	skos:notation	"1512121011" ;
	tempo:validFrom	"2014-08-08"^^xsd:date ;
	tempo:validTill	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/15121210>
