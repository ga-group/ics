<http://data.ga-group.nl/ics/bics/151011>
	a	bddc:BicsLevel3Industry ;
	a	bics:Classifier , owl:NamedIndividual ;
	bics:isIndustryOf	<http://data.ga-group.nl/ics/bics/1510> ;
	dct:isReplacedBy	<http://data.ga-group.nl/ics/bics/16101011> ;
	dct:replaces	<http://data.ga-group.nl/ics/bics/141511> ;
	pav:createdWith	<file:infer-bics.sql> ;
	pav:derivedFrom	[
		a	bddc:BicsLevel3Industry ;
		a	bics:Classifier , prov:AnachronousDerivation ;
		pav:derivedFrom	<http://data.ga-group.nl/ics/bics/2014/141511> ;
		pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
		pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
		skos:definition	"This industry includes real estate investment trusts (REITs). REITS own and develop income-producing real estate and real estate mortgages. Sectors include office, retail, housing, healthcare, hotel, industrial, self-storage and specialty. To be considered a REIT, a company must have most of its assets and income tied to real estate and must distribute at least 90% of it taxable income as dividends to shareholders."@en ;
		skos:notation	"141511" ;
		skos:prefLabel	"REIT"@en ;
		tempo:validFrom	"2014-08-08"^^xsd:date ;
		tempo:validTill	"2020-10-03"^^xsd:date ;
	] , [
		a	bddc:BicsLevel3Industry ;
		a	bics:Classifier , prov:ContemporaryDerivation ;
		pav:derivedFrom	<http://data.ga-group.nl/ics/bics/2014/151011> ;
		pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
		pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
		skos:definition	"This industry includes companies that specialize in discovering, developing and patenting of novel pharmaceuticals. Typically, these companies have high R&D investments, primarily focus on drug discovery/development, and rarely diversify into other verticals. Also, these companies typically pursue high-value/high-risk frontier pharmaceutical targets."@en ;
		skos:notation	"151011" ;
		skos:prefLabel	"Biotech"@en ;
		tempo:validFrom	"2014-08-08"^^xsd:date ;
		tempo:validTill	"2020-10-03"^^xsd:date ;
	] , [
		a	bddc:BicsLevel3Industry ;
		a	bics:Classifier , prov:ContemporaryDerivation ;
		pav:derivedFrom	<http://data.ga-group.nl/ics/bics/2020/151011> , <http://data.ga-group.nl/ics/bics/2024/151011> ;
		pav:sourceAccessedOn	"2023-07-03T18:11:29Z"^^xsd:dateTime ;
		pav:sourceLastAccessedOn	"2024-06-05T14:42:36Z"^^xsd:dateTime ;
		skos:definition	"This industry includes companies that own or develop real estate assets and are structured as a real estate investment trusts (REITs). Companies with other similar structures that provide a tax benefit and have a defined distribution policy are also included. Excludes REITs which primarily invest in real estate loans (see Mortgage REIT)."@en ;
		skos:notation	"151011" ;
		skos:prefLabel	"REIT"@en ;
		tempo:validFrom	"2020-10-03"^^xsd:date ;
	] ;
	pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2024-06-05T14:42:36Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	bics: ;
	skos:definition	"This industry includes companies that own or develop real estate assets and are structured as a real estate investment trusts (REITs). Companies with other similar structures that provide a tax benefit and have a defined distribution policy are also included. Excludes REITs which primarily invest in real estate loans (see Mortgage REIT)."@en ;
	skos:notation	"151011" ;
