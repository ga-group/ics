	skos:notation	"16101212101011" ;
	skos:prefLabel	"Ventricular Assist Devices"@en ;
	tempo:validFrom	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/161012121010>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/1610121210> ;
	dct:replaces	<http://data.ga-group.nl/ics/bics/1512121010> ;
	pav:createdWith	<file:infer-bics.sql> ;
	pav:derivedFrom	[
		a	bddc:BicsLevel5Segment ;
		a	bics:Classifier , prov:AnachronousDerivation ;
		pav:derivedFrom	<http://data.ga-group.nl/ics/bics/2014/1512121010> ;
		pav:sourceAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
		pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
		skos:definition	"This segment includes companies that manufacture electrophysiology devices. These devices typically treat an arrhythmia of the heart (irregular beat) by generating electrical impulses to regulate the heartbeat and are often implanted in or near the patient's heart. This segment also includes companies that manufacture heart pumps and blood pumps that assist a failing heart, as well as replacement hearts. It also includes catheters to treat atrial fibrillation. Products include: pacemakers, implantable cardioverter-defibrillators (ICDs), ventricle assist devices (VADs), defibrillators, ablation catheters, and any other cardiovascular device that uses an electrical impulse that is not a heart monitor."@en ;
		skos:notation	"1512121010" ;
		skos:prefLabel	"Electrophysiology Devices"@en ;
		tempo:validFrom	"2014-08-08"^^xsd:date ;
		tempo:validTill	"2020-10-03"^^xsd:date ;
	] , [
		a	bddc:BicsLevel6Segment ;
		a	bics:Classifier , prov:ContemporaryDerivation ;
		pav:derivedFrom	<http://data.ga-group.nl/ics/bics/2020/161012121010> , <http://data.ga-group.nl/ics/bics/2024/161012121010> ;
		pav:sourceAccessedOn	"2023-07-03T18:11:29Z"^^xsd:dateTime ;
		pav:sourceLastAccessedOn	"2024-06-05T14:42:36Z"^^xsd:dateTime ;
		skos:definition	"This segment includes companies that manufacture electrophysiology devices, including heart pumps, blood pumps, replacement hearts, and catheters used to treat atrial fibrillation. Includes pacemakers, implantable cardioverter-defibrillators (ICDs), ventricle assist devices (VADs), defibrillators, ablation catheters, and any other cardiovascular device that uses an electrical impulse that is not a heart monitor."@en ;
		skos:notation	"161012121010" ;
		skos:prefLabel	"Electrophysiology Devices"@en ;
		tempo:validFrom	"2020-10-03"^^xsd:date ;
	] ;
	pav:sourceAccessedOn	"2023-07-03T18:11:29Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2024-06-05T14:42:36Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	bics: ;
	skos:definition	"This segment includes companies that manufacture electrophysiology devices, including heart pumps, blood pumps, replacement hearts, and catheters used to treat atrial fibrillation. Includes pacemakers, implantable cardioverter-defibrillators (ICDs), ventricle assist devices (VADs), defibrillators, ablation catheters, and any other cardiovascular device that uses an electrical impulse that is not a heart monitor."@en ;
	skos:notation	"161012121010" ;
	skos:prefLabel	"Electrophysiology Devices"@en ;
	tempo:validFrom	"2020-10-03"^^xsd:date .

<http://data.ga-group.nl/ics/bics/161012121011>
	a	bddc:BicsLevel6Segment ;
	a	bics:Classifier , owl:NamedIndividual ;
	bics:isLevel6SegmentOf	<http://data.ga-group.nl/ics/bics/1610121210> ;
	dct:replaces	<http://data.ga-group.nl/ics/bics/1512121011> ;
	pav:createdWith	<file:infer-bics.sql> ;
	pav:derivedFrom	[
		a	bddc:BicsLevel5Segment ;
