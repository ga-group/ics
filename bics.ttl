		pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
		rdfs:label	"Neuromodulation Devices"@en ;
		skos:definition	"This industry subgroup includes companies that manufacture neuromodulation devices. Neuromodulation can be split into two major categories: neurostimulation devices and implantable drug infusion systems. Neurostimulation devices are implantable devices that deliver an electrical current to block pain signals or stimulate neural impulses that were previously absent. Implantable drug infusion systems are implanted pumps that are able to administer much smaller doses of pharmacological agents with fewer side effects because of its direct application."@en ;
		skos:notation	"15121211" ;
		tempo:validFrom	"2014-08-08"^^xsd:date ;
		tempo:validTill	"2020-10-03"^^xsd:date ;
	] , [
		a	bddc:BicsLevel5Segment ;
		a	bics:Classifier , prov:ContemporaryDerivation ;
		pav:derivedFrom	<http://data.ga-group.nl/ics/bics/2020/1610121211> , <http://data.ga-group.nl/ics/bics/2024/1610121211> ;
		pav:sourceAccessedOn	"2023-07-03T18:11:29Z"^^xsd:dateTime ;
		pav:sourceLastAccessedOn	"2024-06-05T14:42:36Z"^^xsd:dateTime ;
		rdfs:label	"Neuromodulation Devices"@en ;
		skos:definition	"This segment includes companies that manufacture neuromodulation devices, including neurostimulation devices and implantable drug infusion systems."@en ;
		skos:notation	"1610121211" ;
		tempo:validFrom	"2020-10-03"^^xsd:date ;
	] ;
	pav:sourceAccessedOn	"2023-07-03T18:11:29Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2024-06-05T14:42:36Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	bics: ;
	rdfs:label	"Neuromodulation Devices"@en ;
	skos:definition	"This segment includes companies that manufacture neuromodulation devices, including neurostimulation devices and implantable drug infusion systems."@en ;
	skos:notation	"1610121211" ;
	tempo:validFrom	"2020-10-03"^^xsd:date .

