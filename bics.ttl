		rdfs:label	"Private Equity"@en ;
		skos:definition	"This industry includes companies that are a type of private equity investment firm, particularly those private equity firms that engage in leveraged buyout (LBO) transactions. Financial sponsors rarely manage a company directly and are most active on issues relating to a company's capital structure and balance sheet and strategic initiatives, such as mergers and acquisitions."@en ;
		skos:notation	"141012" ;
		tempo:validFrom	"2014-08-08"^^xsd:date ;
		tempo:validTill	"2020-10-03"^^xsd:date ;
