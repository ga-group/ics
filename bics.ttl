		skos:definition	"This segment includes companies that aggregate, market and distribute television programs to affiliate TV broadcasting stations. These TV broadcasting stations in turn transmit the programming material to viewers over public airways. Typically, the programming content would be viewed on branded antenna TV channels."@en ;
		skos:notation	"1010121111" ;
		skos:prefLabel	"TV Broadcast Networks"@en ;
		tempo:validFrom	"2014-08-08"^^xsd:date ;
