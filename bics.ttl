		pav:sourceLastAccessedOn	"2024-06-05T14:42:36Z"^^xsd:dateTime ;
		rdfs:label	"Private Equity"@en ;
		skos:definition	"This industry subgroup includes investment firms investing in private companies. Such firms engage in leveraged buyout (LBO) transactions, private placements of securities, and ownership of private companies for investment purposes."@en ;
		skos:notation	"14111012" ;
		tempo:validFrom	"2020-10-03"^^xsd:date ;
	] ;
