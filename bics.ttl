		pav:sourceLastAccessedOn	"2019-12-03T20:05:01Z"^^xsd:dateTime ;
		skos:definition	"This segment includes companies that manufacture ventricular assist devices (VADs). These devices are mechanical pump-type devices that are surgically implanted to function as the left ventricle of a failing heart. These devices are used in heart transplant candidates as a bridge to transplant until a heart transplant is available or as destination therapy, meaning permanent implantation. Examples include Thoratec's HeartMate II and HeartWare's HVAD."@en ;
		skos:notation	"151212101011" ;
		skos:prefLabel	"Ventricular Assist Devices"@en ;
		tempo:validFrom	"2014-08-08"^^xsd:date ;
		tempo:validTill	"2020-10-03"^^xsd:date ;
	] , [
