<http://data.ga-group.nl/ics/icb/2019/>
	a	owl:Ontology ;
	dcat:downloadURL	<http://data.ga-group.nl/ics/icb2019.ttl> ;
	dct:abstract	"""This ontology includes individuals representing the set of classification codes based on the principal business activity of the company.
This set of classification codes is valid from 2019-01-01 till 2019-06-30."""@en ;
	dct:creator	<https://orcid.org/0000-0002-7352-2825> ;
	dct:description	"""The Industry Classification Benchmark (ICB) is an industry classification taxonomy launched by Dow Jones and FTSE in 2005 and now used by FTSE International and STOXX.
Codes are four-tiered, numeric, and not prefix-free.  The first tier is called industry, the second tier is the supersector, the third tier is the sector, and the fourth tier is the subsector.
FTSE/Russell is responsible for assigning an ICB classification to all major public companies.  Each company is allocated to the subsector that most closely represents the nature of its business, which is determined by its source of revenue or where it constitutes the majority of revenue."""@en ;
	dct:format	"text/turtle"^^xsd:string ;
	dct:issued	"2026-05-31T02:25:19Z"^^xsd:dateTime ;
	dct:language	"en"^^xsd:language ;
	dct:license	<https://creativecommons.org/licenses/by-sa/4.0/> ;
	dct:modified	"2026-05-31T02:25:19Z"^^xsd:dateTime ;
	dct:publisher	<https://orcid.org/0000-0002-7352-2825> ;
	dct:title	"icb individuals" ;
	fibo-fnd-utl-av:hasMaturityLevel	fibo-fnd-utl-av:Release ;
	owl:imports	fibo-sec-sec-cls: , ics: ;
	owl:versionInfo	"2019"^^xsd:string ;
	owl:versionIRI	<http://data.ga-group.nl/ics/icb/2019/> ;
	sm:contentLanguage	<https://www.w3.org/TR/owl2-quick-reference/> ;
	rdfs:label	"icb 2019"@en ;
	rdfs:seeAlso	<https://github.com/ga-group/ics> ;
	sm:contributor	"PAMIYA Strategic Advisors GmbH" ;
	sm:copyright	"Copyright (c) 2004 FTSE International Limited" , "Copyright (c) 2004 Dow Jones & Co, Inc." , "Copyright (c) 2022-2026 PAMIYA Strategic Advisors GmbH" ;
	sm:filename	"icb2019.ttl" ;
	tempo:validFrom	"2019-01-01"^^xsd:date ;
	tempo:validTill	"2019-07-01"^^xsd:date ;
	vann:preferredNamespacePrefix	"icb2019"^^xsd:string ;
	vann:preferredNamespaceUri	"http://data.ga-group.nl/ics/icb/2019/" .




