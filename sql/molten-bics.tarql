PREFIX lcc-3166-1-adj: <https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes-Adjunct/>
PREFIX bddc: <https://api.bloomberg.com/eap/catalogs/bbg/classes/>
PREFIX dbo: <https://dbpedia.org/ontology/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX fibo-fbc-fct-bci: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessCentersIndividuals/>
PREFIX fibo-fbc-fct-mkt: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/>
PREFIX fibo-fbc-fct-mkti: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/MarketsIndividuals/>
PREFIX fibo-fbc-pas-fpas: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/>
PREFIX fibo-fnd-plc-vrt: <https://spec.edmcouncil.org/fibo/ontology/FND/Places/VirtualPlaces/>
PREFIX fibo-fnd-arr-arr: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Arrangements/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX tempo: <http://purl.org/tempo/>
PREFIX bics: <http://data.ga-group.nl/ics/bics/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
	?_bics
		a bics:Classifier , owl:NamedIndividual , ?tier ;
		skos:definition ?_defn ;
		rdfs:label ?_lbl , ?_lbl_ja , ?_lbl_fr , ?_lbl_de , ?_lbl_es , ?_lbl_pt , ?_lbl_it , ?_lbl_zh_hant , ?_lbl_ko , ?_lbl_zh , ?_lbl_ru ;

		rdfs:isDefinedBy ?_vbics ;
		skos:notation ?bics ;
		?hasparent ?_pbics ;
		tempo:validFrom	?_from ;
		tempo:validTill	?_till ;
		## provenance
		pav:importedOn ?now ;
		pav:lastRefreshedOn ?now ;
		pav:sourceAccessedOn ?_accd ;
		pav:sourceLastAccessedOn ?_accd ;
}
WHERE {
	BIND(NOW() AS ?now)
	BIND(xsd:dateTime(?accd) AS ?_accd)
	BIND(COALESCE(?vers, SUBSTR(?from,1,4)) AS ?_vers)
	BIND(IRI(CONCAT(STR(bics:),?_vers,'/')) AS ?_vbics)
	BIND(IRI(CONCAT(STR(bics:),?_vers,'/',?BICS_CODE)) AS ?_bics)
	BIND(IRI(CONCAT(STR(bics:),?_vers,'/',SUBSTR(?BICS_CODE,1,STRLEN(?BICS_CODE)-2))) AS ?_pbics)
	BIND(xsd:date(?from) AS ?_from)
	BIND(xsd:date(?till) AS ?_till)
	BIND(STRLANG(?Definition, ?lang) AS ?_defn)
	BIND(STRLANG(?BICS_Name, ?lang) AS ?_lbl)

	## other langs
	BIND(STRLANG(?ja, "ja") AS ?_lbl_ja)
	BIND(STRLANG(?fr, "fr") AS ?_lbl_fr)
	BIND(STRLANG(?de, "de") AS ?_lbl_de)
	BIND(STRLANG(?es, "es") AS ?_lbl_es)
	BIND(STRLANG(?pt, "pt") AS ?_lbl_pt)
	BIND(STRLANG(?it, "it") AS ?_lbl_it)
	BIND(STRLANG(?zh_hant, "zh-hant") AS ?_lbl_zh_hant)
	BIND(STRLANG(?ko, "ko") AS ?_lbl_ko)
	BIND(STRLANG(?zh, "zh") AS ?_lbl_zh)
	BIND(STRLANG(?ru, "ru") AS ?_lbl_ru)

	BIND(STRLEN(?BICS_CODE) AS ?clen)
	VALUES (?clen ?tier ?hasparent) {
	(2 bddc:BicsLevel1Sector UNDEF)
	(4 bddc:BicsLevel2IndustryGroup bics:isIndustryGroupOf)
	(6 bddc:BicsLevel3Industry bics:isIndustryOf)
	(8 bddc:BicsLevel4SubIndustry bics:isSubIndustryOf)
	(10 bddc:BicsLevel5Segment bics:isLevel5SegmentOf)
	(12 bddc:BicsLevel6Segment bics:isLevel6SegmentOf)
	(14 bddc:BicsLevel7Segment bics:isLevel7SegmentOf)
	(16 bddc:BicsLevel8Segment bics:isLevel8SegmentOf)
	}
}
