	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/gics/2016/> ;
	skos:definition	"Empresas dedicadas a la producción de gases industriales."@es , "Fabricantes de gases industriais."@pt , "Hersteller von Industriegasen."@de , "Manufacturers of industrial gases."@en , "Producteurs de gaz industriels."@fr , "Società produttrici di gas industriali."@it , "Производители промышленных газов."@ru , "工业气体制造商。"@zh , "工業氣體製造商"@zh-hant , "工業用ガスの製造会社。"@ja , "산업용 가스 제조업체."@ko ;
