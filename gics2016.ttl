<http://data.ga-group.nl/ics/gics/2016/45202030>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
	a	gics:SubindustryClassifier , owl:NamedIndividual ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/gics/45202030> ;
	dct:isReplacedBy	<http://data.ga-group.nl/ics/gics/2018/45202030> ;
