<http://data.ga-group.nl/ics/gics/2016/40102010>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
	a	gics:SubindustryClassifier , owl:NamedIndividual ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/gics/40102010> ;
	dct:isReplacedBy	<http://data.ga-group.nl/ics/gics/2018/40102010> ;
