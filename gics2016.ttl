	skos:prefLabel	"Destiladores y Vinateros"@es , "Destilarias e Viticultores"@pt , "Distillers & Vintners"@en , "Производство спирта и вин"@ru , "蒸留酒・ワイン"@ja , "酿酒商与葡萄酒商"@zh , "釀酒商與葡萄酒商"@zh-hant , "증류업체와 양조업체"@ko ;
	tempo:validFrom	"2016-09-01"^^xsd:date ;
	tempo:validTill	"2018-09-29"^^xsd:date .

