<http://data.ga-group.nl/ics/gics/2016/20202010>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
	a	gics:SubindustryClassifier , owl:NamedIndividual ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/gics/20202010> ;
	dct:isReplacedBy	<http://data.ga-group.nl/ics/gics/2018/20202010> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/gics/20202010> ;
