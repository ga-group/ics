<http://data.ga-group.nl/ics/gics/2016/40204010>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
	a	gics:SubindustryClassifier , owl:NamedIndividual ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/gics/40204010> ;
	dct:isReplacedBy	<http://data.ga-group.nl/ics/gics/2018/40204010> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/gics/40204010> ;
	dct:replaces	<http://data.ga-group.nl/ics/gics/2014/40402030> ;
	gics:isSubindustryOf	<http://data.ga-group.nl/ics/gics/2016/402040> ;
	pav:importedOn	"2026-05-27T08:45:00.430Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-05-31T09:56:29.350Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2017-10-19T03:38:28Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-06-07T09:41:30Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/gics/2016/> ;
	skos:definition	"Companies or Trusts that service, originate, purchase and/or securitize residential and/or commercial mortgage loans.  Includes trusts that invest in mortgage-backed securities and other mortgage related assets."@en , "Empresas o fideicomisos que dan servicio, originan, compran o aseguran préstamos hipotecarios residenciales o comerciales. Se incluyen los fideicomisos que invierten en valores con garantía hipotecaria y otros activos relacionados con las hipotecas."@es , "Empresas ou Trustes que atendem, originam, compram e/ou garantem empréstimos hipotecários comerciais e/ou residenciais.  Inclui trustes que investem em títulos garantidos por hipotecas e outros bens relativos à hipoteca."@pt , "Компании или трасты, занимающиеся обслуживанием, предоставлением, приобретением и (или) секьюритизацией коммерческих ипотечных кредитов, в том числе трасты, занимающиеся инвестициями в ипотечные ценные бумаги и другие активы, обеспеченные ипотекой."@ru , "从事提供、发起、购买住宅和／或商业抵押贷款，及／或相关资产证券化业务的公司或信托公司。包括投资抵押担保证券和其他相关抵押相关资产的信托公司。"@zh , "住宅もしくは商業用不動産担保ローンを取得して証券化する会社もしくは信託機関。モーゲージREIT担保証券（MBS）へ投資する投資信託も含む。"@ja , "從事發起、購買住宅和/或者商業抵押貸款服務，和/或者相關資產證券化業務的公司或信託公司。包括在抵押擔保證券和其他相關資產抵押方面進行投資的信託公司。"@zh-hant , "주거용 및/또는 상업용 모기지 대출을 서비스, 출시, 구매 및/또는 증권화하는 기업 또는 신탁회사. 모기지담보부 증권과 기타 모기지 관련 자산에 투자하는 신탁회사 포함."@ko ;
	skos:inScheme	<http://data.ga-group.nl/ics/gics/2016/> ;
	skos:notation	"40204010" ;
	skos:prefLabel	"Mortgage REITs"@en , "REIT Hipotecários"@pt , "REIT Hipotecarias"@es , "Ипотечныe инвестиционные фонды недвижимости (REIT)"@ru , "モーゲージ不動産投資信託（REIT）"@ja , "抵押房地产投资信托"@zh , "抵押房地產投資信托"@zh-hant , "모기지 리츠"@ko ;
	tempo:validFrom	"2016-09-01"^^xsd:date ;
	tempo:validTill	"2018-09-29"^^xsd:date .

<http://data.ga-group.nl/ics/gics/2016/402040>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
	a	gics:IndustryClassifier , owl:NamedIndividual ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/gics/402040> ;
