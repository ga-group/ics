<http://data.ga-group.nl/ics/trbc/2008/>
	a	owl:Ontology ;
	dcat:downloadURL	<http://data.ga-group.nl/ics/trbc2008.ttl> ;
	dct:abstract	"""This ontology includes individuals representing the set of classification codes based on the principal business activity of the company.
This set of classification codes is valid from 2008 till 2012."""@en ;
	dct:creator	<https://orcid.org/0000-0002-7352-2825> ;
	dct:description	"""The Thomson Reuters Business Classification (TRBC) is an industry classification taxonomy launched by Reuters in 2004 as RBSS, and is now used by LSEG after the merger with Refinitiv.
Codes are four-tiered, numeric, and not prefix-free.  The first tier is called economic sector, the second tier is the business sector, the third tier is the industry group, and the fourth tier is the industry.
Thomson-Reuters is responsible for assigning a TRBC classification to all major public as well as many private companies.  Each company is allocated to the industry that most closely represents the nature of its business according to the TRBC classification methodology."""@en ;
	dct:format	"text/turtle"^^xsd:string ;
	dct:issued	"2026-06-03T02:25:19Z"^^xsd:dateTime ;
	dct:language	"en"^^xsd:language ;
	dct:license	<https://creativecommons.org/licenses/by-sa/4.0/> ;
	dct:modified	"2026-06-03T02:25:19Z"^^xsd:dateTime ;
	dct:publisher	<https://orcid.org/0000-0002-7352-2825> ;
	dct:title	"trbc individuals" ;
	fibo-fnd-utl-av:hasMaturityLevel	fibo-fnd-utl-av:Release ;
	owl:imports	trbc: , ics: ;
	owl:versionInfo	"2008"^^xsd:string ;
	owl:versionIRI	<http://data.ga-group.nl/ics/trbc/2008/> ;
	sm:contentLanguage	<https://www.w3.org/TR/owl2-quick-reference/> ;
	rdfs:label	"TRBC 2008"@en ;
	rdfs:seeAlso	<https://github.com/ga-group/ics> ;
	sm:contributor	"PAMIYA Strategic Advisors GmbH" ;
	sm:copyright	"Copyright (c) 2008 Thomson Reuters Corp" , "Copyright (c) 2022-2026 PAMIYA Strategic Advisors GmbH" ;
	sm:filename	"trbc2008.ttl" ;
	tempo:validFrom	"2008"^^xsd:gYear ;
	tempo:validTill	"2012"^^xsd:gYear ;
	vann:preferredNamespacePrefix	"trbc2008"^^xsd:string ;
	vann:preferredNamespaceUri	"http://data.ga-group.nl/ics/trbc/2008/" .




