	skos:definition	"Aziende che forniscono servizi di trasporto merci via terra."@it , "Companies providing ground transportation services for goods and freight."@en , "Empresas que prestam serviços de transporte terrestre de mercadorias e cargas."@pt , "Sociétés qui fournissent des services de transport terrestre pour les marchandises et le fret."@fr , "Unternehmen, die Bodentransportdienstleistungen für Waren und Fracht anbieten."@de , "Компании, предоставляющие услуги по перевозке товаров и грузов наземным транспортом."@ru , "商品・貨物の陸上輸送サービスを行う会社"@ja , "提供地面货运服务的公司。"@zh , "為貨物和貨運提供地面運輸服務的公司。"@zh-hant , "상품및화물에대한육상운송서비스를제공하는회사."@ko ;
	skos:inScheme	<http://data.ga-group.nl/ics/gics/2023/> ;
	skos:notation	"20304030" ;
	skos:prefLabel	"Cargo Ground Transportation"@en , "Landfrachttransport"@de , "Transport terrestre de fret (nouveau)"@fr , "Transporte Terrestre de Cargas (nova)"@pt , "Trasporto cargo via terra (nuovo)"@it , "Грузовые перевозки наземным транспортом (новое)"@ru , "地面货运（新）"@zh , "貨物陸上輸送（新設）"@ja , "貨物陸運（新）"@zh-hant , "화물육상운송 (신규)"@ko ;
	tempo:validFrom	"2023-03-18"^^xsd:date .

<http://data.ga-group.nl/ics/gics/2023/20304040>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
	a	gics:SubindustryClassifier , owl:NamedIndividual ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/gics/20304040> ;
