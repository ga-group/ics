	skos:notation	"45203020" ;
	skos:prefLabel	"Electronic Manufacturing Services"@en , "Serviços de Fabricação de Eletrônicos"@pt , "Servicios de Fabricación Electrónica"@es , "电子制造服务"@zh , "電子製品製造サービス"@ja , "전자 제조 서비스"@ko ;
	tempo:validFrom	"2023-03-18"^^xsd:date .

<http://data.ga-group.nl/ics/gics/2023/45203030>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
	a	gics:SubindustryClassifier , owl:NamedIndividual ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/gics/45203030> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/gics/45203030> ;
