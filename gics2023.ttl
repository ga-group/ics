	skos:prefLabel	"Rail Transportation"@en , "Schienentransport"@de , "Transport ferroviaire (nouveau nom)"@fr , "Transporte Ferroviário (nome novo)"@pt , "Trasporto ferroviario (nuovo nome)"@it , "Vías Férreas"@es , "Деятельность железнодорожного транспорта (новое наименование)"@ru , "鉄道運輸（新名称）"@ja , "鐵路運輸（新名稱）"@zh-hant , "铁路运输（新名称）"@zh , "철도운송 (새명칭)"@ko ;
	tempo:validFrom	"2023-03-18"^^xsd:date .

