	pav:sourceLastAccessedOn	"2026-05-29T15:08:11Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/gics/2023/> ;
	skos:definition	"Aziende impegnate nella ricerca, sviluppo o produzione di prodotti farmaceutici. Sono inclusi i farmaci veterinari."@it , "Companies engaged in the research, development or production of pharmaceuticals, including active pharmaceutical ingredients (APIs) and veterinary drugs."@en , "Empresas dedicadas a la investigación, desarrollo o producción de productos farmacéuticos. Se incluyen los fármacos veterinarios."@es , "Empresas envolvidas na pesquisa, desenvolvimento ou produção de produtos farmacêuticos. Inclui medicamentos veterinários."@pt , "Sociétés spécialisées dans la recherche, le développement ou la production de produits pharmaceutiques, y compris dans le domaine vétérinaire."@fr , "Unternehmen, die in der Erforschung, Entwicklung oder Herstellung von Pharmazeutika tätig sind. Hierzu gehören auch veterinärmedizinische Präparate."@de , "Компании, занимающиеся исследованием, разработкой или производством фармацевтической продукции, в том числе лекарственных препаратов для животных."@ru , "从事药品的研究、开发与生产的公司。包括兽药。"@zh , "医薬品の研究・開発・製造を行う会社。獣医用医薬品を含む。"@ja , "從事藥物研究、開發或生產的公司。包括獸醫藥品（獸藥）。"@zh-hant , "약품의 연구, 개발 또는 생산과 관련된 회사. 동물용 약 포함."@ko ;
	skos:inScheme	<http://data.ga-group.nl/ics/gics/2023/> ;
	skos:notation	"35202010" ;
	skos:prefLabel	"Farmaceutica"@it , "Pharmaceuticals"@en , "Pharmazie"@de , "Productos Farmacéuticos"@es , "Produits pharmaceutiques"@fr , "Produtos Farmacêuticos"@pt , "Производство фармацевтической продукции"@ru , "制药"@zh , "医薬品"@ja , "製藥"@zh-hant , "제약"@ko ;
	tempo:validFrom	"2023-03-18"^^xsd:date .

