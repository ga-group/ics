	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/gics/2023/> ;
	skos:definition	"Empresas dedicadas a la fabricación de calzado. Se incluyen los fabricantes de calzado deportivo y de cuero."@es , "Fabricantes de calçados. Inclui sapatos esportivos e de couro."@pt , "Fabricants de chaussures. Sont inclus les fabricants de chaussures en cuir et de chaussures de sport."@fr , "Hersteller von Fußbekleidung. Dazu gehören auch Sport- und Lederschuhe."@de , "Manufacturers of footwear including sport and leather shoes."@en , "Produttori di calzature. Sono comprese le calzature sportive e in pelle."@it , "Производители обуви. Производители обуви, в том числе спортивной и кожаной."@ru , "履物の製造会社。スポーツ用および皮製の靴を含む。"@ja , "鞋类用品制造商。包括运动鞋和皮鞋。"@zh , "鞋類用品製造商。包括運動鞋和皮鞋。"@zh-hant , "신발 제조업체. 운동화와 가죽 신발 포함."@ko ;
	skos:inScheme	<http://data.ga-group.nl/ics/gics/2023/> ;
	skos:notation	"25203020" ;
	skos:prefLabel	"Calçados"@pt , "Calzado"@es , "Calzature"@it , "Chaussures"@fr , "Footwear"@en , "Fußbekleidung"@de , "Производство обуви"@ru , "履物"@ja , "鞋类"@zh , "鞋類"@zh-hant , "신발"@ko ;
	tempo:validFrom	"2023-03-18"^^xsd:date .

