<http://data.ga-group.nl/ics/rbss/2004/>
	a	owl:Ontology ;
	dcat:downloadURL	<http://data.ga-group.nl/ics/rbss2004.ttl> ;
	dct:abstract	"""This ontology includes individuals representing the set of classification codes based on the principal business activity of the company.
This set of classification codes is valid from 2004 till 2008."""@en ;
	dct:creator	<https://orcid.org/0000-0002-7352-2825> ;
	dct:description	"""The Reuters Business Sector Scheme (RBSS) is an industry classification taxonomy launched by Reuters in 2004, and has since been transformed into TRBC (The Refinitiv Business Classification) by LSEG after the merger with Refinitiv.
Codes are numeric.
Reuters is responsible for assigning an RBSS classification code to all major public companies.  Each company is allocated to the industry that most closely represents the nature of its business according to the RBSS classification methodology."""@en ;
	dct:format	"text/turtle"^^xsd:string ;
	dct:issued	"2026-06-03T02:25:19Z"^^xsd:dateTime ;
	dct:language	"en"^^xsd:language ;
	dct:license	<https://creativecommons.org/licenses/by-sa/4.0/> ;
	dct:modified	"2026-06-03T02:25:19Z"^^xsd:dateTime ;
	dct:publisher	<https://orcid.org/0000-0002-7352-2825> ;
	dct:title	"rbss individuals" ;
	fibo-fnd-utl-av:hasMaturityLevel	fibo-fnd-utl-av:Release ;
	owl:imports	fibo-sec-sec-cls: , ics: ;
	owl:versionInfo	"2008"^^xsd:string ;
	owl:versionIRI	<http://data.ga-group.nl/ics/rbss/2004/> ;
	sm:contentLanguage	<https://www.w3.org/TR/owl2-quick-reference/> ;
	rdfs:label	"RBSS 2004"@en ;
	rdfs:seeAlso	<https://github.com/ga-group/ics> ;
	sm:contributor	"PAMIYA Strategic Advisors GmbH" ;
	sm:copyright	"Copyright (c) 2004 Reuters Group" , "Copyright (c) 2022-2026 PAMIYA Strategic Advisors GmbH" ;
	sm:filename	"rbss2004.ttl" ;
	tempo:validFrom	"2004"^^xsd:gYear ;
	tempo:validTill	"2008"^^xsd:gYear ;
	vann:preferredNamespacePrefix	"rbss2004"^^xsd:string ;
	vann:preferredNamespaceUri	"http://data.ga-group.nl/ics/rbss/2004/" .




