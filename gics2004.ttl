<http://data.ga-group.nl/ics/gics/2004/>
	a	owl:Ontology ;
	dcat:downloadURL	<https://github.com/ga-group/ics/gics.ttl> ;
	dct:abstract	"""This ontology includes individuals representing the set of classification codes based on the principal business activity of the company.
This set of classification codes is valid from 2004-05-01 till 2005-04-30."""@en ;
	dct:creator	<https://orcid.org/0000-0002-7352-2825> ;
	dct:description	"""The Global Industry Classification Standard (GICS) is an industry taxonomy developed in 1999 by MSCI and Standard & Poor's (S&P) for use by the global financial community.
Codes are four-tiered, numeric, and not prefix-free.  The first tier is the sector, the second tier is the industry group, the third tier is the industry, and the fourth tier is the sub-industry.
S&P is responsible for assigning a GICS code to all major public companies.  The assignment is based on the principal busines activity of the company."""@en ;
	dct:format	"text/turtle"^^xsd:string ;
	dct:issued	"2026-05-24T02:25:19Z"^^xsd:dateTime ;
	dct:language	"en"^^xsd:language ;
	dct:license	<https://creativecommons.org/licenses/by-sa/4.0/> ;
	dct:modified	"2026-05-24T02:25:19Z"^^xsd:dateTime ;
	dct:publisher	<https://orcid.org/0000-0002-7352-2825> ;
	dct:replaces	<http://data.ga-group.nl/ics/gics/2003/> ;
	dct:title	"gics individuals" ;
	fibo-fnd-utl-av:hasMaturityLevel	fibo-fnd-utl-av:Release ;
	owl:imports	fibo-sec-sec-cls: , ics: ;
	owl:versionInfo	"2004"^^xsd:string ;
	owl:versionIRI	<http://data.ga-group.nl/ics/gics/2004/> ;
	sm:contentLanguage	<https://www.w3.org/TR/owl2-quick-reference/> ;
	rdfs:label	"gics"@en ;
	rdfs:seeAlso	<https://github.com/ga-group/ics> ;
	sm:contributor	"PAMIYA Strategic Advisors GmbH" ;
	sm:copyright	"Copyright (c) 1999 S&P Dow Jones Indices LLC" , "Copyright (c) 1999 MSCI Inc." , "Copyright (c) 2019-2026 PAMIYA Strategic Advisors GmbH" ;
	sm:filename	"gics.ttl" ;
        tempo:validFrom	"2004-05-01"^^xsd:date ;
        tempo:validTill	"2005-04-30"^^xsd:date ;
	vann:preferredNamespacePrefix	"gics2004"^^xsd:string ;
	vann:preferredNamespaceUri	"http://data.ga-group.nl/ics/gics/2004/" .




