	sm:filename	"bics2024.ttl" ;
	tempo:validFrom	"2024"^^xsd:gYear ;
	vann:preferredNamespacePrefix	"bics2024"^^xsd:string ;
	vann:preferredNamespaceUri	"http://data.ga-group.nl/ics/bics/2024/" .




