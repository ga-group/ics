<http://data.ga-group.nl/ics/gics/2018/15101050>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
	a	gics:SubindustryClassifier , owl:NamedIndividual ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/gics/15101050> ;
	dct:isReplacedBy	<http://data.ga-group.nl/ics/gics/2023/15101050> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/gics/15101050> ;
	dct:replaces	<http://data.ga-group.nl/ics/gics/2016/15101050> ;
	gics:isSubindustryOf	<http://data.ga-group.nl/ics/gics/2018/151010> ;
	pav:importedOn	"2026-05-27T08:45:00.430Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-05-31T07:22:42.157Z"^^xsd:dateTime ;
