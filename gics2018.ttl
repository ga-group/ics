	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/gics/2018/> ;
	rdfs:label	"Gas industriali"@it , "Gases Industriais"@pt , "Gases Industriales"@es , "Gaz industriels"@fr , "Industrial Gases"@en , "Industriegase"@de , "Производство промышленных газов"@ru , "工业气体"@zh , "工业气体"@zh-hant , "工業用ガス"@ja , "산업용 가스"@ko ;
	skos:definition	"Empresas dedicadas a la producción de gases industriales."@es , "Fabricantes de gases industriais."@pt , "Hersteller von Industriegasen."@de , "Manufacturers of industrial gases."@en , "Producteurs de gaz industriels."@fr , "Produttori di gas industriali."@it , "Производители промышленных газов."@ru , "工业气体制造商。"@zh , "工业气体制造商。"@zh-hant , "工業用ガスの製造会社。"@ja , "산업용 가스 제조업체."@ko ;
