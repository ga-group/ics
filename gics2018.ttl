	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/gics/2018/> ;
	rdfs:label	"Diversified REITs"@en , "REIT Diversificadas"@es , "Verschiedene REITs"@de , "各種不動産投資信���"@ja , "多样化房地产投资信托"@zh , "多样化房地产投资信托"@zh-hant , "다각화된 리츠"@ko ;
	skos:definition	"2種以上の不動産タイプに渡って多角的に経営を展開する会社または信託機関。"@ja , "2가지 이상의 자산 유형에 걸쳐 상당히 다각화된 운영을 하고 있는 회사나 신탁회사."@ko , "A company or Trust with significantly diversified operations across two or more property types."@en , "Ein Unternehmen oder Trust mit stark diversifizierten Aktivitäten über zwei oder mehr Immobilientypen hinweg."@de , "Empresas o fideicomisos con operaciones considerablemente diversificadas en dos o más tipos de inmuebles."@es , "涉足两种或以上物业类型的多样化业务的公司或信托公司。"@zh , "涉足两种或以上物业类型的多样化业务的公司或信托公司。"@zh-hant ;
	skos:notation	"60101010" ;
	tempo:validFrom	"2018-09-29"^^xsd:date ;
	tempo:validTill	"2023-03-18"^^xsd:date .

<http://data.ga-group.nl/ics/gics/2018/60101020>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
	a	gics:SubindustryClassifier , owl:NamedIndividual ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/gics/60101020> ;
