	rdfs:label	"Calçados"@pt , "Calzado"@es , "Chaussures"@fr , "Footwear"@en , "Fußbekleidung"@de , "Industria calzaturiera"@it , "Производство обуви"@ru , "履物"@ja , "鞋类"@zh , "鞋类"@zh-hant , "신발"@ko ;
	skos:definition	"Empresas dedicadas a la fabricación de calzado. Se incluyen los fabricantes de calzado deportivo y de cuero."@es , "Fabricantes de calçados. Inclui sapatos esportivos e de couro."@pt , "Fabricants de chaussures. Sont inclus les fabricants de chaussures en cuir et de chaussures de sport."@fr , "Hersteller von Fußbekleidung. Dazu gehören auch Sport- und Lederschuhe."@de , "Manufacturers of footwear. Includes sport and leather shoes."@en , "Produttori di calzature. Sono comprese le calzature sportive e in pelle."@it , "Производители обуви, в том числе спортивной и кожаной."@ru , "履物の製造会社。スポーツ用および皮製の靴を含む。"@ja , "鞋类用品制造商。包括运动鞋和皮鞋。"@zh , "鞋类用品制造商。包括运动鞋和皮鞋。"@zh-hant , "신발 제조업체. 운동화와 가죽 신발 포함."@ko ;
	skos:notation	"25203020" ;
	tempo:validFrom	"2018-09-29"^^xsd:date ;
	tempo:validTill	"2023-03-18"^^xsd:date .

<http://data.ga-group.nl/ics/gics/2018/25203030>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
