	rdfs:label	"Cobre"@es , "Cobre"@pt , "Copper"@en , "Cuivre"@fr , "Kupfer"@de , "Rame"@it , "Меднодобывающая промышленность"@ru , "銅"@ja , "铜"@zh , "铜"@zh-hant , "구리"@ko ;
	skos:definition	"Aziende operanti principalmente nell'estrazione del minerale di rame."@it , "Companies involved primarily in copper ore mining."@en , "Empresas dedicadas principalmente a la extracción de cobre."@es , "Empresas envolvidas principalmente na mineração de cobre."@pt , "Les sociétés principalement actives dans l'exploitation minière du minerai de cuivre."@fr , "Unternehmen, die primär im Kupfererzabbau tätig sind."@de , "Компании, занятые добычей медной руды."@ru , "主に銅鉱石の採掘を行う会社"@ja , "主要从事铜矿开采的公司。"@zh , "主要从事铜矿开采的公司。"@zh-hant , "주로 구리광석 채굴에 관련된 회사."@ko ;
	skos:notation	"15104025" ;
