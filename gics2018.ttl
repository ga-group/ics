	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
	a	gics:SubindustryClassifier , owl:NamedIndividual ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/gics/35203010> ;
	dct:isReplacedBy	<http://data.ga-group.nl/ics/gics/2023/35203010> ;
