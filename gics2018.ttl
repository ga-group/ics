	pav:importedOn	"2026-05-27T08:45:00.430Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-05-31T07:22:42.157Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2018-10-01T08:17:21Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-06-07T09:41:30Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/gics/2018/> ;
	rdfs:label	"Data Processing & Outsourced Services"@en , "Datenverarbeitungs- & Outsourcing-Dienste"@de , "Elaborazione dati e servizi in outsourcing"@it , "Procesamiento de Datos y Servicios Subcontratados"@es , "Serviços Terceirizados e de Processamento de Dados"@pt , "Traitement des données et services externalisés"@fr , "Предоставление услуг по обработке данных и услуги, предоставление которых передано другим компаниям"@ru , "情報処理・外注サービス"@ja , "数据处理与外包服务"@zh , "数据处理与外包服务"@zh-hant , "데이터 처리 및 아웃소싱 서비스"@ko ;
	skos:definition	"Anbieter von kommerziellen Diensten für die elektronische Datenverarbeitung und/oder Outsourcing von Geschäftsprozessen.  Hierzu gehören auch Unternehmen, die Dienste für die Backoffice-Automatisierung anbieten."@de , "Empresas que proporcionan servicios de procesamiento electrónico de datos comerciales y/o servicios de subcontratación de procesos empresariales. Se incluyen empresas que proporcionan servicios de automatización de Back Office."@es , "Fornitori di servizi commerciali di elaborazione elettronica dei dati e/o di esternalizzazione di processi aziendali.  Sono comprese le aziende che forniscono servizi per l'automazione di back-office."@it , "Fournisseurs de services de traitement des données électroniques commerciales et/ou de services externalisés des processus d’entreprises.  Sont incluses les entreprises qui offrent des services d'automatisation du back-office."@fr , "Provedores de serviços de processamento de dados eletrônicos comerciais e/ou terceirização de processos comerciais. Inclui empresas que prestam serviços para automação de retaguarda."@pt , "Providers of commercial electronic data processing and/or business process outsourcing services.  Includes companies that provide services for back-office automation."@en , "Провайдеры услуг по обработке коммерческих данных и (или) аутсорсингу бизнес-процессов.  В данную группу входят компании, предоставляющие услуги по автоматизации бэк-офиса."@ru , "商業電子情報処理、会社業務外注サービスの提供業者。バックオフィス自動化サービスを提供する会社を含む。"@ja , "提供商业电子数据处理和/或经营流程外包服务的公司。包括那些提供事务部门办公自动化服务的公司。"@zh , "提供商业电子数据处理和/或经营流程外包服务的公司。包括那些提供事务部门办公自动化服务的公司。"@zh-hant , "상업용 전자 데이터 처리 및/또는 비즈니스 프로세스 아웃소싱 서비스 제공업체. 백오피스 자동화를 위한 서비스 제공 회사 포함."@ko ;
	skos:notation	"45102020" ;
	tempo:validFrom	"2018-09-29"^^xsd:date ;
	tempo:validTill	"2023-03-18"^^xsd:date .

