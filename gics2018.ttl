<http://data.ga-group.nl/ics/gics/2018/10102010>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
	a	gics:SubindustryClassifier , owl:NamedIndividual ;
	dct:isContemporaryVersionOf	<http://data.ga-group.nl/ics/gics/10102010> ;
	dct:isReplacedBy	<http://data.ga-group.nl/ics/gics/2023/10102010> ;
	dct:isVersionOf	<http://data.ga-group.nl/ics/gics/10102010> ;
	dct:replaces	<http://data.ga-group.nl/ics/gics/2016/10102010> ;
	gics:isSubindustryOf	<http://data.ga-group.nl/ics/gics/2018/101020> ;
	pav:importedOn	"2026-05-27T08:45:00.430Z"^^xsd:dateTime ;
	pav:lastRefreshedOn	"2026-05-31T07:22:42.157Z"^^xsd:dateTime ;
	pav:sourceAccessedOn	"2018-10-01T08:17:21Z"^^xsd:dateTime ;
	pav:sourceLastAccessedOn	"2019-06-07T09:41:30Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/gics/2018/> ;
	rdfs:label	"Gaz et pétrole intégrés"@fr , "Integrated Oil & Gas"@en , "Integrierte Erdöl- und Erdgasunternehmen"@de , "Petróleo e Gás Integrados"@pt , "Petróleo y Gas Integrados"@es , "Petrolio e gas integrati"@it , "Интегрированные нефтяные и газовые компании"@ru , "総合石油・ガス"@ja , "综合性石油与天然气企业"@zh , "综合性石油与天然气企业"@zh-hant , "종합 석유 및 가스"@ko ;
	skos:definition	"Compagnie petrolifere integrate impegnate nella prospezione e produzione di petrolio e gas, nonché in almeno un'altra attività significativa nei settori della raffinazione, della commercializzazione e del trasporto oppure nell'ambito delle sostanze chimiche."@it , "Compagnies pétrolières intégrées spécialisées dans l'exploration et la production de pétrole et de gaz, ainsi que dans au moins une autre activité importante suivante : raffinage, commercialisation et transport, ou produits chimiques."@fr , "Empresas petrolíferas integradas que se dedicam à exploração e produção de petróleo e gás, assim como pelo menos uma outra atividade significativa nas áreas de refino, comercialização e transporte, ou produtos químicos."@pt , "Empresas petroleras integradas dedicadas a la exploración y producción de petróleo y gas, asi como alguna otra actividad importante relacionada con el refinado, comercialización y transporte, o productos químicos."@es , "Integrated oil companies engaged in the exploration & production of oil and gas, as well as at least one other significant activity in either refining, marketing and transportation, or chemicals."@en , "Integrierte Erdölunternehmen, die in der Exploration und Produktion von Erdöl- und Erdgasprodukten tätig sind sowie mindestens einer weiteren wichtigen Tätigkeit in den Bereichen Raffinierung, Vermarktung und Transport oder Chemikalien nachgehen."@de , "Интегрированные нефтяные компании, занятые разведкой и добычей нефти и газа, а также как минимум одним из других основных видов деятельности по переработке, сбыту и транспортировке нефти, газа или химической продукции."@ru , "从事石油及天然气勘探与生产，并且在炼制、营销、运输或者石油化工四項之中至少一項领域有大量业务的综合性石油公司。"@zh , "从事石油及天然气勘探与生产，并且在炼制、营销、运输或者石油化工四項之中至少一項领域有大量业务的综合性石油公司。"@zh-hant , "石油・ガスの探査・開発を行い、精製・販売・輸送・化学品製造のいずれか少なくとも一分野において顕著な活動が見られる総合石油会社。"@ja , "석유와 가스의 탐사 및 생산과 관련된 종합 석유 회사로서, 정유, 마케팅, 수송, 화학 중 최소한 한 가지의 다른 주요 활동을 하는 기업."@ko ;
	skos:notation	"10102010" ;
	tempo:validFrom	"2018-09-29"^^xsd:date ;
	tempo:validTill	"2023-03-18"^^xsd:date .

<http://data.ga-group.nl/ics/gics/2018/10102020>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
