	pav:sourceLastAccessedOn	"2019-06-07T09:41:30Z"^^xsd:dateTime ;
	rdfs:isDefinedBy	<http://data.ga-group.nl/ics/gics/2018/> ;
	rdfs:label	"Industrial REITs"@en , "Industrielle REITs"@de , "REIT Industriales"@es , "工业房地产投资信托"@zh , "工业房地产投资信托"@zh-hant , "工業用不動産投資信託"@ja , "산업 리츠"@ko ;
	skos:definition	"Companies or Trusts engaged in the acquisition, development, ownership, leasing, management and operation of industrial properties. Includes companies operating industrial warehouses and distribution properties."@en , "Empresas o fideicomisos dedicados a la adquisición, desarrollo, propiedad, alquiler, administración y operación de bienes inmuebles industriales. Se incluyen las empresas que operan almacenes industriales e inmuebles de distribución."@es , "Unternehmen oder Trusts, die sich mit dem Erwerb, der Entwicklung, dem Besitz, der Vermietung, der Verwaltung und dem Betrieb von Industrieimmobilien befassen. Umfasst Unternehmen, die Industrielager und Vertriebsimmobilien betreiben."@de , "从事工业物业的收购、开发、所有权、租赁、管理和经营的公司或信托公司。包括经营工业仓库和物流物业的公司。"@zh , "从事工业物业的收购、开发、所有权、租赁、管理和经营的公司或信托公司。包括经营工业仓库和物流物业的公司。"@zh-hant , "工業用不動産の買収、開発、所有、賃貸、管理、運営を行う会社または信託機関。産業倉庫および配送施設を運営する会社を含む。"@ja , "산업 자산의 획득, 개발, 소유, 임대, 관리, 운영과 관련된 회사나 신탁. 산업 창고와 유통 자산을 운영하는 회사 포함."@ko ;
	skos:notation	"60101020" ;
	tempo:validFrom	"2018-09-29"^^xsd:date ;
	tempo:validTill	"2023-03-18"^^xsd:date .

<http://data.ga-group.nl/ics/gics/2018/60101030>
	a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
