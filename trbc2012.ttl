	sm:filename	"trbc2012.ttl" ;
	tempo:validFrom	"2012"^^xsd:gYear ;
	tempo:validTill	"2020"^^xsd:gYear ;
	vann:preferredNamespacePrefix	"trbc2012"^^xsd:string ;
	vann:preferredNamespaceUri	"http://data.ga-group.nl/ics/trbc/2012/" .




