	pav:sourceLastAccessedOn	"2019-06-07T09:41:30Z"^^xsd:dateTime ;
	rdfs:label	"Independent Power Producers & Energy Traders"@en ;
	skos:definition	"Companies that operate as Independent Power Producers (IPPs), Gas & Power Marketing & Trading Specialists and/or Integrated Energy Merchants. Includes producers of solar power and wind power, used to generate electricity. Also includes companies that generate electricity and/or power through alternative energy sources such as biogas, biomass, clean energy, geothermal, waste, water and waves.  Excludes electric transmission companies and utility distribution companies classified in the Electric Utilities Sub-Industry."@en ;
	skos:notation	"55105010" ;
	tempo:validFrom	"2010-07-01"^^xsd:date .

