		rdfs:label	"Research & Consulting Services"@en ;
		skos:definition	"Companies primarily providing research and consulting services to businesses and governments not classified elsewhere.  Includes companies involved in management consulting services, architectural design, business information or scientific research, marketing, and testing & certification services. Excludes companies providing information technology consulting services classified in the IT Consulting & Other Services Sub-Industry."@en ;
		skos:notation	"20202020" ;
		tempo:validFrom	"2008-08-30"^^xsd:date , "2016-09-01"^^xsd:date ;
