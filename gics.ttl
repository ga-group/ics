	rdfs:label	"Commodity Chemicals"@en ;
	skos:definition	"Companies that primarily produce industrial chemicals and basic chemicals. Includes plastics, synthetic fibers, films, paints, explosives and petrochemicals. Excludes chemical companies classified in the Diversified Chemicals, Fertilizers & Agricultural Chemicals, Industrial Gases, or Specialty Chemicals sub-industries."@en ;
	skos:notation	"15101010" ;
	tempo:validFrom	"1999-01-01"^^xsd:date .

