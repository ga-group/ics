		rdfs:label	"Diversified Support Services"@en ;
		skos:definition	"Companies primarily providing labor oriented support services to businesses and governments.  Includes commercial cleaning services, dining & catering services, equipment repair services, industrial maintenance services, industrial auctioneers, storage & warehousing, transaction services, uniform rental services, and other business support services."@en ;
		skos:notation	"20201070" ;
		tempo:validFrom	"2008-08-30"^^xsd:date , "2016-09-01"^^xsd:date ;
		tempo:validTill	"2014-03-01"^^xsd:date , "2023-03-18"^^xsd:date ;
