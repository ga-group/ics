		rdfs:label	"Human Resource & Employment Services"@en ;
		skos:definition	"Companies providing business support services relating to human capital management. Includes employment agencies, employee training, payroll & benefit support services, retirement support services and temporary agencies."@en ;
		skos:notation	"20202010" ;
		tempo:validFrom	"2008-08-30"^^xsd:date ;
		tempo:validTill	"2023-03-18"^^xsd:date ;
	] , [
		a	fibo-sec-sec-cls:GlobalIndustryClassificationStandardsClassifier ;
